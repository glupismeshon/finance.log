{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "finance-log",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": true
	},
	"main": "worker/index.js",
	"assets": {
		"directory": "dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		"GOOGLE_CLIENT_ID": "839074567407-ik3741jit4g7oh7edl4c7nbbpngvpj42.apps.googleusercontent.com",
		"APP_ORIGIN": "https://finance-log.money-log.workers.dev",
		"TELEGRAM_BOT_NAME": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "finance-log",
			"database_id": "0b4f8980-94db-4d9c-a1eb-5b2b2153afaa"
		}
	]
}